{
    // Everything works without changes. Set a value only to override.
    //
    // Each language block can hold:
    //   program path(s): "executable" (or "java_home", "sources", "dotnet_root", "compiler")
    //   "server": null to auto-detect, a command list such as ["pylsp"], or false to turn it off
    //   "settings": sent to the server (its workspace configuration)
    //   "initialization_options": sent when the server starts
    //   any feature switch below without its "lsp_" prefix, e.g. "inlay_hints": false

    "lsp_enabled": true,
    // How long to wait for a server before showing built-in suggestions.
    "lsp_completion_timeout_ms": 1500,

    // Feature switches (defaults for every language).
    "lsp_diagnostics": true,          // underline errors and warnings
    "lsp_signature_help": true,       // parameter help while typing a call
    "lsp_highlight_references": true, // outline other uses of the name under the cursor
    "lsp_show_hints": true,           // gray squiggle for unused and deprecated code
    "lsp_inlay_hints": true,          // faint inline types and parameter names
    "lsp_code_lens": true,            // "Run | 3 references" links above functions
    "lsp_document_links": true,       // underline #include paths and links; hover to open
    "lsp_format_on_save": false,      // format the file when saving
    "lsp_format_on_save_timeout_ms": 1500,
    "lsp_format_on_type": false,      // server fixes after typing ";" or Enter
    // Heavy, so off by default. Run "Intellekt: Add Semantic Colors to Color
    // Scheme" once, then turn them on.
    // Experimental: Sublime fills token backgrounds instead of recoloring
    // text, so this draws colored blocks. Leave off.
    "lsp_semantic_highlighting": false, // server-based coloring
    "lsp_inactive_regions": false,      // dim C/C++ code left out by #if / #ifdef

