    // Leave a path empty to auto-detect it.
    // python_executable overrides virtual environment detection.
    "python_executable": "",
    "ruby_executable": "",
    "java_home": "",
    "java_sources": [],
    "node_executable": "",
    "tsc_executable": "",
    "dotnet_root": "",
    "go_executable": "",
    "php_executable": "",
    "rustc_executable": "",
    "cxx_compiler": "",
    "perl_executable": "",
